;; Fixture for the bounded note4_v1 import interface.
(module
  (import "note4_v1" "emit" (func $emit (param i32 i32) (result i32)))
  (memory (export "memory") 1 1)
  (data (i32.const 0) "NOTE4")
  (func (export "step") (result i32)
    (local $i i32) (local $sum i32)
    (loop $next
      (local.set $i (i32.add (local.get $i) (i32.const 1)))
      (local.set $sum (i32.add (local.get $sum) (local.get $i)))
      (br_if $next (i32.lt_u (local.get $i) (i32.const 64))))
    (drop (call $emit (i32.const 0) (i32.const 5)))
    (local.get $sum))
  (func (export "out_of_bounds") (result i32)
    (i32.load (i32.const 65536)))
  (func (export "bad_import") (result i32)
    (call $emit (i32.const -4) (i32.const 8)))
  (func (export "long_import") (result i32)
    (call $emit (i32.const 0) (i32.const 128)))
  (func (export "grow") (result i32)
    (memory.grow (i32.const 1)))
  (func (export "constant32") (result i32) (i32.const 0x12345678))
  (func (export "constant64") (result i32)
    (i64.eq (i64.const 0x123456789abcdef0) (i64.const 0x123456789abcdef0)))
  (func (export "constant64_high") (result i32)
    (i32.wrap_i64 (i64.shr_u (i64.const 0x123456789abcdef0) (i64.const 32))))
  (func (export "constant_float64") (result i32)
    (f64.eq (f64.const 1.25) (f64.const 1.25)))
  (func (export "constant_float64_value") (result i32)
    (i32.trunc_f64_s (f64.mul (f64.const 1.25) (f64.const 8))))
  (func (export "spin") (result i32)
    (loop $forever (br $forever))
    (i32.const 0))
  (func $recurse (export "recurse") (result i32)
    (call $recurse))
  (func (export "wrong_result") (result i64) (i64.const 1))
  (func (export "needs_argument") (param i32) (result i32) (local.get 0)))
