# Full product, including direct HTTPS, Web transfer and the streamed reader.
CONFIG_ZECTRIX_ENABLE_CONNECTIVITY=y
CONFIG_ZECTRIX_ENABLE_WIFI=y
CONFIG_ZECTRIX_ENABLE_WIFI_HTTP=y
CONFIG_ZECTRIX_ENABLE_BOOK_TRANSFER=y
CONFIG_ZECTRIX_ENABLE_READER=y
CONFIG_ZECTRIX_ENABLE_USB_CLI=y
CONFIG_ZECTRIX_ENABLE_UPDATE=y
