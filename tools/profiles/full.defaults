# Full product, including direct HTTPS, Web transfer and the streamed reader.
CONFIG_NOTE4_ENABLE_UI_CHINESE=y
CONFIG_NOTE4_UI_DEFAULT_CHINESE=y
CONFIG_NOTE4_ENABLE_CONNECTIVITY=y
CONFIG_NOTE4_ENABLE_WIFI=y
CONFIG_NOTE4_ENABLE_WIFI_HTTP=y
CONFIG_NOTE4_ENABLE_BOOK_TRANSFER=y
CONFIG_NOTE4_ENABLE_READER=y
CONFIG_NOTE4_ENABLE_RUNTIME=y
CONFIG_NOTE4_ENABLE_UTILITIES=y
CONFIG_NOTE4_ENABLE_USB_CLI=y
CONFIG_NOTE4_ENABLE_USB_HOST=y
CONFIG_NOTE4_ENABLE_UPDATE=y
