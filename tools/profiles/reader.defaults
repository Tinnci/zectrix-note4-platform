# Offline reader with bilingual UI and USB library management.
CONFIG_NOTE4_ENABLE_UI_CHINESE=y
CONFIG_NOTE4_UI_DEFAULT_CHINESE=y
CONFIG_NOTE4_ENABLE_CONNECTIVITY=n
CONFIG_NOTE4_ENABLE_WIFI=n
CONFIG_NOTE4_ENABLE_WIFI_HTTP=n
CONFIG_NOTE4_ENABLE_BOOK_TRANSFER=n
CONFIG_NOTE4_ENABLE_READER=y
CONFIG_NOTE4_ENABLE_RUNTIME=n
CONFIG_NOTE4_ENABLE_UTILITIES=n
CONFIG_NOTE4_ENABLE_USB_CLI=y
CONFIG_NOTE4_ENABLE_USB_HOST=y
CONFIG_NOTE4_ENABLE_UPDATE=y
