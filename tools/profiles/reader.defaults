# Offline reader with bilingual UI and USB library management.
CONFIG_ZECTRIX_ENABLE_UI_CHINESE=y
CONFIG_ZECTRIX_UI_DEFAULT_CHINESE=y
CONFIG_ZECTRIX_ENABLE_CONNECTIVITY=n
CONFIG_ZECTRIX_ENABLE_WIFI=n
CONFIG_ZECTRIX_ENABLE_WIFI_HTTP=n
CONFIG_ZECTRIX_ENABLE_BOOK_TRANSFER=n
CONFIG_ZECTRIX_ENABLE_READER=y
CONFIG_ZECTRIX_ENABLE_RUNTIME=n
CONFIG_ZECTRIX_ENABLE_UTILITIES=n
CONFIG_ZECTRIX_ENABLE_USB_CLI=y
CONFIG_ZECTRIX_ENABLE_USB_HOST=y
CONFIG_ZECTRIX_ENABLE_UPDATE=y
