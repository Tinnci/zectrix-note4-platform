menu "Note4 modules"
    config NOTE4_ENABLE_UTILITIES
        bool "Native pocket tools"
        default y
        help
            Include the offline focus timer, browsable calendar and tally
            counter. They share the existing time service and foreground UI;
            no network, storage writes or background task is required.

    rsource "../components/ui/Kconfig.projbuild"
    rsource "../components/note4_connectivity/Kconfig.projbuild"
    rsource "../components/note4_reader/Kconfig.projbuild"
    rsource "../components/note4_runtime/Kconfig.projbuild"
    rsource "../components/note4_cli/Kconfig.projbuild"
    rsource "../components/note4_update/Kconfig.projbuild"
endmenu
