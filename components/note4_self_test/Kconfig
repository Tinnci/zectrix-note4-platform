menu "Note4 hardware showcase"

config NOTE4_QUALIFICATION_RF_TARGET_SSID
    string "Optional Wi-Fi SSID for RF qualification"
    default ""
    help
        Leave empty for a generic scan test. Set an SSID to require three
        consecutive observations at or above the configured RSSI threshold.

config NOTE4_QUALIFICATION_RF_THRESHOLD_DBM
    int "RF qualification threshold (dBm)"
    range -100 -20
    default -70

config NOTE4_QUALIFICATION_NFC_URL
    string "Temporary NFC demonstration URL"
    default "https://github.com/Tinnci/zectrix-note4-platform"

endmenu
