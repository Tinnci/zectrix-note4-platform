config NOTE4_ENABLE_UI_CHINESE
    bool "Simplified Chinese system language"
    default y
    help
        Include Chinese system strings and 16px UI glyphs. The UI reuses the
        reader font when present, or a compact subset without the reader.
        Disable this and the reader to remove all Chinese font data.

config NOTE4_UI_DEFAULT_CHINESE
    bool "Use Chinese until a language preference is saved"
    depends on NOTE4_ENABLE_UI_CHINESE
    default y
