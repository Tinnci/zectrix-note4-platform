diff --git a/source/m3_exec_defs.h b/source/m3_exec_defs.h
--- a/source/m3_exec_defs.h
+++ b/source/m3_exec_defs.h
@@ -47,8 +47,15 @@
 #define d_m3RetSig                  static inline m3ret_t vectorcall
 #define d_m3Op(NAME)                M3_NO_UBSAN op_section d_m3RetSig op_##NAME (d_m3OpSig)

-#define nextOpImpl()                ((IM3Operation)(* _pc))(_pc + 1, d_m3OpArgs)
-#define jumpOpImpl(PC)              ((IM3Operation)(*  PC))( PC + 1, d_m3OpArgs)
+// All dispatch paths, including loop bodies and branches, consume budget.
+d_m3RetSig MeteredDispatch (d_m3OpSig)
+{
+    m3ret_t trap = m3_Yield ();
+    if (UNLIKELY(trap)) return trap;
+    return ((IM3Operation)(* _pc))(_pc + 1, d_m3OpArgs);
+}
+#define nextOpImpl()                MeteredDispatch(_pc, d_m3OpArgs)
+#define jumpOpImpl(PC)              MeteredDispatch((pc_t)(PC), d_m3OpArgs)

 #define nextOpDirect()              return nextOpImpl()
 #define jumpOpDirect(PC)            return jumpOpImpl((pc_t)(PC))
