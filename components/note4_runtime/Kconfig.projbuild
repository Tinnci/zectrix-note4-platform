config NOTE4_ENABLE_RUNTIME
    bool "Sandboxed Lua micro-apps"
    default y
    help
        Enable a foreground-only Lua 5.4 runtime with bounded memory, instructions
        and copied drawing commands. Independent .lua files share the content
        filesystem through a separate app namespace. USB Manager can install
        scripts when USB host management is enabled.

config NOTE4_ENABLE_WASM
    bool "Bounded WebAssembly execution library"
    depends on NOTE4_ENABLE_RUNTIME
    default n
    help
        Optional single-owner Wasm interpreter with copied imports and quotas.
        Lua packages remain the launcher format; this library does not silently
        reinterpret .lua/.zapp files as Wasm. Enable for native integration.

choice NOTE4_WASM_ENGINE
    prompt "WebAssembly backend"
    depends on NOTE4_ENABLE_WASM
    default NOTE4_WASM_ENGINE_WAMR
config NOTE4_WASM_ENGINE_WAMR
    bool "WAMR classic interpreter"
config NOTE4_WASM_ENGINE_WASM3
    bool "Wasm3 metered interpreter"
endchoice
